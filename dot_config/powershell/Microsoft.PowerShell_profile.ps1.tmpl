# Set environment variables
{{ range $name, $value := .powershell.env -}}
$env:{{ $name }} = {{ $value | quote }}
{{ end }}

{{- "\n" -}}

{{ $paths := index .powershell.path .chezmoi.os }}
{{ if $paths -}}
# Append to PATH
$pathSeparator = [System.IO.Path]::PathSeparator
{{ range $paths -}}
$env:PATH += "$pathSeparator{{ . }}"
{{ end -}}
{{ end }}

{{- "\n" -}}

# Include functions
. "$PSScriptRoot\functions.ps1"

# Create alias functions
{{ range $alias, $expr := .powershell.aliases -}}
function {{ $alias }} { {{ $expr }} @args }
{{ end }}

{{- "\n" -}}

{{ if .powershell.commands.noninteractive -}}
# Run non-interactive commands always
{{ range .powershell.commands.noninteractive -}}
{{ . }}
{{ end -}}
}
{{- "\n" -}}
{{ end -}}

# Run interactive commands if PSReadLine is available
if (Get-Module PSReadLine) {
{{ range .powershell.commands.interactive -}}
{{ . | indent 2 }}
{{ end -}}
}

# Fix missing GPG_TTY environment variable on Linux.
if ($IsLinux) {
    $tty = tty 2>$null

    if ($LASTEXITCODE -eq 0) {
        $env:GPG_TTY = $tty
    }
}
